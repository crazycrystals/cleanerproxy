# Server-side configuration for cleanerproxy.
#
# Contains no provider credentials. cleanerproxy forwards the client's own auth
# headers to the upstream unchanged (see copyRequestHeaders in
# internal/proxy/server.go), so the provider token lives only in the client
# config and never on this host.
#
# Primary run mode: `go run ./cmd/cleanerproxy` (no Docker needed).
# Docker alternative: `docker compose up -d` (uses the guardian container for
# Tier 2 instead of oMLX).

# The upstream being inspected. The whole pipeline assumes this host may be
# hostile: it authors the responses that Tier 0/1/2 exist to check.
#
# IMPORTANT: no trailing /v1. forward() builds the target as
#   <upstream path> + <incoming request path>
# and the client sends /v1/messages, so a /v1 here yields
#   /v1/v1/messages
# which 404s.
CLEANERPROXY_ANTHROPIC_UPSTREAM=https://api.anthropic.com

# Only Anthropic models are routed through the proxy for now.
# oMLX speaks OpenAI-compatible, so route /v1/chat/completions there too.
# This means local models also get response inspection + PII redaction.
CLEANERPROXY_OPENAI_UPSTREAM=http://127.0.0.1:8001

# defang: blocked tool calls are replaced with an approval prompt shown to the
# user. Press allow for false positives — one keystroke beats incident response.
CLEANERPROXY_POLICY=defang

# Tier 2 runs locally, so no conversation content leaves this host.
CLEANERPROXY_CLASSIFIER_ENABLED=true

# Guardian backend: "omlx" for native macOS (via oMLX), "llama" for Docker
# (via llama.cpp container). oMLX is the default for native runs.
CLEANERPROXY_GUARDIAN_BACKEND=omlx

# oMLX serves the classifier model. The base URL is the oMLX server, not
# /v1 — the backend appends the path itself.
CLEANERPROXY_CLASSIFIER_BASE_URL=http://127.0.0.1:8001

# oMLX API key (required when oMLX has key auth enabled).
CLEANERPROXY_CLASSIFIER_API_KEY=

# Model ID as seen in oMLX's /v1/models. This is the directory name within
# the oMLX models dir.
CLEANERPROXY_CLASSIFIER_MODEL=granite-guardian-3.2-3b-a800m-4bit

# function_call is the model's own trained criterion and measured best
# on internal/evalset (AUC 0.986). Do not change without re-measuring.
CLEANERPROXY_GUARDIAN_VARIANT=function_call
CLEANERPROXY_SEMANTIC_BLOCK_CONFIDENCE=0.7
CLEANERPROXY_CLASSIFY_ALL=false

# Vouching off by default: lets a probabilistic tier overrule a deterministic
# one. Turn on only when the FPR on live traffic justifies it.
CLEANERPROXY_VOUCH_ENABLED=false

# Human-in-the-loop approval.
CLEANERPROXY_APPROVAL_ENABLED=true

# Bind address for the published cleanerproxy port. 127.0.0.1 keeps it
# reachable only from this host.
BIND_ADDR=127.0.0.1

# Passthrough listener: identical inspection pipeline (Tier 0/1/2, approval,
# adguard, content-filter, audit) but with pseudonymization DISABLED.
# Point a client here when redaction is causing issues. Empty = disabled.
# CLEANERPROXY_PASSTHROUGH_LISTEN=:8788

# Encrypts the audit log at rest with AES-256-GCM. Generate with:
#   openssl rand -hex 32
CLEANERPROXY_AUDIT_KEY=

# Pseudonymization: bidirectional PII/secret redaction. Real values are
# replaced with format-preserving pseudonyms before leaving this machine,
# and reversed on the response path. The model and upstream see only fake
# names, tokens, and addresses.
CLEANERPROXY_PSEUDONYMIZE=true

# Comma-separated list of real names to detect and replace. Supplements NER
# — useful as a fallback if the local model is down, or for names the model
# might miss (single-word handles, unusual spellings). Leave empty if NER
# covers everything you need.
# CLEANERPROXY_PSEUDONYM_NAMES=

# File path to persist the pseudonym vault across restarts. Without this,
# mappings are lost on restart and a new set of pseudonyms is generated.
# CLEANERPROXY_PSEUDONYM_STATE=.cleanerproxy-vault.json

# NER-based name discovery: calls a local model to extract person names from
# every request. Catches names not in the seed list. Uses oMLX chat
# completions — the call stays on localhost.
CLEANERPROXY_PSEUDONYM_NER=true

# Model for NER extraction. Must support chat completions and follow
# instructions well enough to return a JSON array. Qwen2.5-0.5B is 276MB
# quantized — negligible RAM impact alongside the classifier.
CLEANERPROXY_PSEUDONYM_NER_MODEL=Qwen2.5-0.5B-Instruct-4bit

# Timeout for a single NER call. 10s is generous for a local 9B model.
CLEANERPROXY_PSEUDONYM_NER_TIMEOUT=10s

# Desktop notifications: macOS alerts + Notification Center banners,
# Linux notify-send, and/or ntfy.sh push notifications.
# Events write a detail .txt file; on macOS, the alert's "View" button opens
# it in TextEdit.
CLEANERPROXY_NOTIFY=true

# Directory for notification detail files.
# macOS default: ~/Library/Logs/cleanerproxy/notify
# Linux default: ~/.local/state/cleanerproxy/notify
# CLEANERPROXY_NOTIFY_DIR=

# Minimum interval between same-category notifications.
CLEANERPROXY_NOTIFY_COOLDOWN=30s

# ntfy.sh push notifications: fire alongside desktop notifications, or as
# the sole notification path on headless/server environments. Recommended
# for Hermes agent users who need remote approval on mobile.
#
# Set to your ntfy topic URL (self-hosted or ntfy.sh):
# CLEANERPROXY_NTFY_URL=https://ntfy.sh/my-cleanerproxy
#
# Optional access token for authenticated topics:
# CLEANERPROXY_NTFY_TOKEN=tk_...

# Ad Guard: detect and clean advertisement content injected by shady relay
# services. Scans response text for blocked domains, affiliate URLs,
# promotional language, and prompt leakage indicators.
CLEANERPROXY_ADGUARD=true

# Extra domains to block (merged with built-in gambling/scam list).
# CLEANERPROXY_ADGUARD_BLOCKED_DOMAINS=evil-relay.xyz,scam-hosting.com
